// Prisma Schema for ZaUI Market Enterprise Backend

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  pending
  shipping
  completed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
}

enum DeliveryType {
  shipping
  pickup
}

enum AdminRole {
  SUPER_ADMIN
  MANAGER
  ORDER_HANDLER
  INVENTORY_STAFF
}

model AdminUser {
  id        String    @id @default(uuid())
  username  String    @unique
  password  String
  name      String
  role      AdminRole @default(MANAGER)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Category {
  id           Int       @id @default(autoincrement())
  name         String
  image        String
  displayOrder Int       @default(0) @map("display_order")
  products     Product[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id            Int         @id @default(autoincrement())
  name          String
  price         Float
  originalPrice Float?      @map("original_price")
  image         String
  detail        String?
  sizes         String[]    @default([])
  colors        String[]    @default([])
  isFlashSale   Boolean     @default(false) @map("is_flash_sale")
  isRecommended Boolean     @default(false) @map("is_recommended")
  stockQuantity Int         @default(100) @map("stock_quantity")
  categoryId    Int         @map("category_id")
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([isFlashSale])
  @@index([isRecommended])
  @@map("products")
}

model Banner {
  id           Int      @id @default(autoincrement())
  imageUrl     String   @map("image_url")
  linkUrl      String?  @map("link_url")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model Station {
  id        Int      @id @default(autoincrement())
  name      String
  image     String
  address   String
  lat       Float
  lng       Float
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stations")
}

model User {
  id        String   @id // Zalo User ID
  name      String
  avatar    String
  phone     String
  email     String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Order {
  id             Int           @id @default(autoincrement())
  userId         String?       @map("user_id")
  user           User?         @relation(fields: [userId], references: [id])
  status         OrderStatus   @default(pending)
  paymentStatus  PaymentStatus @default(pending) @map("payment_status")
  deliveryType   DeliveryType  @default(shipping) @map("delivery_type")
  recipientName  String?       @map("recipient_name")
  recipientPhone String?       @map("recipient_phone")
  shippingAddress String?      @map("shipping_address")
  stationId      Int?          @map("station_id")
  station        Station?      @relation(fields: [stationId], references: [id])
  total          Float
  note           String?
  items          OrderItem[]
  createdAt      DateTime      @default(now()) @map("created_at")
  receivedAt     DateTime?     @map("received_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float

  @@map("order_items")
}

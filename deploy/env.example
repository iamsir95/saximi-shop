SAXIMI_DOMAIN=example.com
JWT_SECRET=change-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-admin-password
PUBLIC_SITE_URL=https://example.com

# VietQR / SePay payment settings.
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=SAXIMI SHOP
SEPAY_WEBHOOK_API_KEY=change-to-sepay-webhook-api-key

# Optional web push keys.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# OTP settings.
OTP_SECRET=change-to-a-long-random-otp-secret
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5

# Zalo OA manual OTP delivery.
# Admin opens this dashboard, copies the OTP message from Saximi Admin, and sends it in Zalo OA.
ZALO_OA_DASHBOARD_URL=https://oa.zalo.me/manage/dashboard#

# Optional S3-compatible Object Storage backup settings.
S3_ENDPOINT=https://storage.example.com
S3_BUCKET=saximi-shop-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
